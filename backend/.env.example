# AI API 配置 — Anthropic（Claude 原生 API）
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=

# AI API 配置 — OpenAI 兼容（OpenAI / DeepSeek 等）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# 默认模型选择 (anthropic 或 openai)
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# DeepSeek 配置示例：
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=deepseek-chat

# 观测日志
LOG_LLM_METRICS=true
LOG_LEVEL=INFO

# Token 预算
CONTEXT_BUDGET_TOKENS=120000          # 摘要同步、JSON 修复等全上下文场景
CHAT_HISTORY_BUDGET=60000             # 澄清对话（测 warn 可临时调小）
SINGLE_CALL_INPUT_BUDGET=100000       # PRD / 接口文档 / 提示词等单次生成
TOKEN_BUDGET_MODE=warn                # warn 仅警告，reject 超预算拒绝调用
TOKEN_ESTIMATOR=tiktoken              # token 估算方式，失败时自动降级字符估算

# 服务器配置
HOST=127.0.0.1
PORT=8001

# CORS 配置
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# SQLite 与单机任务运行时（相对路径基于启动工作目录，建议使用绝对路径）
# DATABASE_PATH=/absolute/path/to/sessions.db
SQLITE_BUSY_TIMEOUT_MS=5000
JOB_POLL_INTERVAL=0.1
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_MAX_CONCURRENCY=2
JOB_SHUTDOWN_TIMEOUT=5
JOB_RUN_TIMEOUT=1200
LLM_CALL_TIMEOUT=180
LLM_STREAM_IDLE_TIMEOUT=120
JOB_MAX_QUEUED=100
JOB_HEALTH_FAILURE_SECONDS=30
JOB_PROGRESS_FLUSH_INTERVAL=0.25
JOB_PROGRESS_FLUSH_BYTES=4096

# 资源路径默认来自项目目录，可使用绝对路径覆盖
# RESOURCES_DIR=/absolute/path/to/resources
# SKILLS_ROOT=/absolute/path/to/skills
# SKILLS_CONFIG_PATH=/absolute/path/to/skills.yaml
# MODELS_CONFIG_PATH=/absolute/path/to/models.yaml
