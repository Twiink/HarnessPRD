# AI API 配置 — Anthropic（Claude 原生 API）
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=

# AI API 配置 — OpenAI 兼容（OpenAI / DeepSeek 等）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
# DeepSeek 示例：
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=deepseek-chat

# 默认模型选择 (anthropic 或 openai)
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022
# 观测日志
LOG_LLM_METRICS=true
LOG_LEVEL=INFO

# Token 预算
CONTEXT_BUDGET_TOKENS=120000          # 摘要同步、JSON 修复等全上下文场景
CHAT_HISTORY_BUDGET=60000             # 澄清对话（测 warn 可临时调小）
SINGLE_CALL_INPUT_BUDGET=100000       # PRD / 接口文档 / 提示词等单次生成
TOKEN_BUDGET_MODE=warn                # warn 仅警告，reject 超预算拒绝调用
TOKEN_ESTIMATOR=tiktoken              # token 估算方式，失败时自动降级字符估算

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
